# Public Firebase web-app configuration, not a service account or private key.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FUNCTIONS_REGION=asia-southeast1
# Set only after native Google setup and google-services.json are installed.
VITE_NATIVE_GOOGLE_ENABLED=false
# Development only; production builds ignore the emulator toggle.
VITE_USE_EMULATORS=false
