rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function owner(uid) { return request.auth != null && request.auth.uid == uid; }
  function shortText(data, key, max) { return !(key in data) || (data[key] is string && data[key].size() <= max); }
  function validProfile() {
    let d = request.resource.data;
    return d.keys().hasOnly(['name','studentId','course','year','email','avatar','settings','createdAt'])
      && shortText(d, 'name', 100)
      && shortText(d, 'studentId', 100)
      && shortText(d, 'course', 100)
      && (!('year' in d) || d.year in ['1','2','3','4','5'])
      && (!('email' in d) || d.email == request.auth.token.email)
      && shortText(d, 'avatar', 180000)
      && (!('settings' in d) || (d.settings is map && d.settings.keys().hasOnly(['notifications','theme']) && d.settings.notifications is bool && d.settings.theme in ['light','dark','system']))
      && (!('createdAt' in d) || d.createdAt is timestamp);
  }
  function validSubject() {
    let d = request.resource.data;
    return d.keys().hasOnly(['subject','day','time','end','teacher','room'])
      && d.keys().hasAll(['subject','day','time','end','teacher','room'])
      && d.subject is string && d.subject.size() > 0 && d.subject.size() <= 120
      && d.day is int && d.day >= 0 && d.day <= 6
      && d.time is string && d.end is string
      && d.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
      && d.end.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
      && d.time < d.end
      && d.teacher is string && d.teacher.size() <= 120
      && d.room is string && d.room.size() <= 100;
  }

  match /users/{uid} {
    allow read: if owner(uid);
    allow create, update: if owner(uid) && validProfile();
    allow delete: if false;

    match /subjects/{id} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid) && validSubject();
    }
    match /attendance/{id} {
      allow read: if owner(uid);
      allow write: if false;
    }
    match /notifications/{id} {
      allow read: if owner(uid);
      allow update: if owner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read is bool;
      allow create, delete: if false;
    }
  }

  // School management collections are strictly server-only via trusted Cloud Functions
  match /schoolClasses/{document=**} { allow read, write: if false; }
  match /attendanceSessions/{document=**} { allow read, write: if false; }
  match /auditLogs/{document=**} { allow read, write: if false; }

  // Default deny all other documents
  match /{document=**} { allow read, write: if false; }
 }
}
